# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# PyTorch checkpoints and large model weight binaries
*.pt
*.pth
*.bin
*.gguf
*.safetensors
*.onnx

# Allow lightweight reference outputs in examples
!examples/**/*.gguf

# Large training datasets and raw crawls
data/raw/*.jsonl
data/*.bin
*.jsonl

# Preserve data manifests, tokenizers, and dataset metadata
!data/data_info.json
!data/tokenizer.json
!data/raw/sources.json

# Preserve training logs, metrics, and loss plots
!out/**/*.csv
!out/**/*.png
!out/**/data_info.json
!out/**/tokenizer.json

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Operating System specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDEs and text editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Temporary files and logs
*.log
*.tmp
*.bak
